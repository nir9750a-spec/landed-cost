# Python
__pycache__/
*.pyc

# workspace/ is scratch: generated scenes, rendered ads, video frames. The heavy assets live
# on the Higgsfield CDN and are re-downloaded on demand, so only the STATE files are tracked —
# CI needs them to know which scenes are spent and what the last run did.
workspace/*
!workspace/runs.jsonl
!workspace/scene-bank/
workspace/scene-bank/*
!workspace/scene-bank/index.json
!workspace/cutouts/
workspace/cutouts/*
!workspace/cutouts/index.json

# Personal reference photos of Nir (and family) live here for avatar generation.
# The repo is PUBLIC — these must never be pushed. The avatar registry only needs the
# Higgsfield media_id/url, not the source file.
assets/*.jpg
assets/*.jpeg
assets/*.png
assets/recliner_real/
!assets/logo.png
!assets/logo_rgba.png
